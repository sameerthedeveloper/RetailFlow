# Copy this file to ".env" and fill in ONE of the two blocks below.
# With neither block set, the app runs in preview mode (data saved in the browser).

# Optional: force a backend. One of: mern | firebase | local
# VITE_BACKEND=

# --- MERN backend (Express + MongoDB, see /backend) ---
# VITE_BASE_URL=http://localhost:8001/api

# --- Firebase demo deployment (Firebase console > Project settings > Your apps) ---
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
